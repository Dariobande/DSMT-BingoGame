%% src/bingo.app.src

{application, bingo,
 [{description, "Distributed Bingo Game"},
  {vsn, "0.1.0"},
  {registered, [main_server]},
  {mod, {bingo_app, []}},
  {applications,
   [kernel,
    stdlib,
    mnesia,
    crypto,
    cowlib,
    ranch,
    cowboy,
    jsx
   ]},
  {env,[]},
  {modules, []},
  {licenses, ["Apache-2.0"]},
  {links, []}
 ]}.